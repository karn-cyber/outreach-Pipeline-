# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Nothing here is committed; the program reads everything from the environment.
# ---------------------------------------------------------------------------

# --- Stage 1: Ocean.io (lookalike companies) ---
# Settings -> API tokens in the Ocean.io app.
OCEAN_API_TOKEN=

# --- Stage 2: Prospeo (decision-makers + LinkedIn URLs) ---
# app.prospeo.io -> API key (X-KEY).
PROSPEO_API_KEY=

# --- Stage 3: Eazyreach (LinkedIn URL -> verified work email) ---
# IMPORTANT: confirm the exact base URL / endpoint / auth header from your
# Eazyreach dashboard (Settings -> API / Developers). The defaults below are a
# best guess and are fully overridable here without touching code.
EAZYREACH_API_KEY=
EAZYREACH_BASE_URL=https://api.eazyreach.app
EAZYREACH_RESOLVE_PATH=/v1/enrich/email
# How the key is sent. One of: "api-key" (header api-key: <key>),
# "x-api-key", or "bearer" (Authorization: Bearer <key>).
EAZYREACH_AUTH_STYLE=api-key
# If you can't confirm the API yet, set this to true to fake email resolution
# so you can still demo the full pipeline. (Real Ocean/Prospeo/Brevo still run.)
EAZYREACH_MOCK=false

# --- Stage 4: Brevo (send) ---
# app.brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=

# --- Your sender identity (must be a VERIFIED sender on your domain) ---
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name
REPLY_TO_EMAIL=you@yourdomain.com

# --- Used to personalise the outreach copy ---
YOUR_COMPANY_NAME=Acme
YOUR_ONE_LINER=we help B2B teams automate cold outreach end to end
YOUR_CALENDAR_LINK=https://cal.com/you/15min

# --- Safe defaults (override on the CLI too) ---
DEFAULT_MIN_SCORE=0.80
DEFAULT_MAX_COMPANIES=10
DEFAULT_MAX_PROSPECTS_PER_COMPANY=3
DEFAULT_MAX_EMAILS=25
